# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Optional for local development: use a public tunnel or production endpoint
GITHUB_WEBHOOK_URL=

# Optional: migrate automation to a GitHub App. OAuth remains as a fallback.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the PEM value; Vercel also accepts escaped newlines (\n).
GITHUB_APP_PRIVATE_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Supabase (all database access in this app is server-side)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js / NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# 32 random bytes encoded as 64 hexadecimal characters
TOKEN_ENCRYPTION_KEY=

# Optional tuning
MAX_DIFF_CHARS=60000
DAILY_REVIEW_LIMIT=50
CRON_SECRET=
GITHUB_API_VERSION=2022-11-28
